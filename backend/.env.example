# ===============================
# Database (PostgreSQL + pgvector)
# ===============================
DATABASE_URL=postgresql+asyncpg://jobpilot:password@localhost:5432/jobpilot

# ===============================
# Redis & Celery
# ===============================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===============================
# Kafka (Local, Aiven.io, or Cloud)
# ===============================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=jobpilot-group
# For Aiven.io (SASL_SSL mode):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=your_aiven_password
# Optional: path to Aiven ca.pem or raw cert text if custom CA verification is needed
# KAFKA_SSL_CA_CERT=ca.pem

# ===============================
# LLMs & AI APIs
# ===============================
# Groq (Primary LLM)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (Fallback LLM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b:free

# Jina AI
JINA_API_KEY=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Firecrawl (Web Scraping)
FIRECRAWL_API_KEY=

# ===============================
# App Security
# ===============================
SECRET_KEY=change-this-to-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*
